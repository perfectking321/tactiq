# Settings for hosting. Copy to ".env" for docker compose, or paste these into your host's "Environment" screen.
# NEVER commit a real .env file.

# --- required -------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Long random string that signs login tokens. Generate a NEW one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- recommended ----------------------------------------------------------
# Models (a Flash model is on the free tier; the fallback is used if the main one is busy)
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# The one-click demo profile on the login screen. "true" is good for a showcase; set "false" for real users.
DEMO_MODE=true

# --- only if the web app is on a DIFFERENT address than the API ------------
# (not needed with the Dockerfile: the web app and API share one address)
# CORS_ORIGINS=https://your-frontend.example.com

# --- optional --------------------------------------------------------------
# Where the SQLite database lives. The Dockerfile sets /data; mount a persistent volume there.
# DATA_DIR=/data
# Or use a managed Postgres instead of SQLite (postgres:// URLs are converted automatically):
# DATABASE_URL=postgresql://user:password@host:5432/tactiq
JWT_EXPIRE_HOURS=24

# Per-IP request limits per minute (logins/sign-ups, and AI calls which use your Gemini quota)
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_AI_PER_MIN=20
