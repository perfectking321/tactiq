# Copy this file to .env and fill in the values. Never commit .env.

# Free key from https://aistudio.google.com/apikey (free tier, no billing needed)
GEMINI_API_KEY=
# A Flash model is on the free tier. List models your key can use: python -m app.rag.llm
GEMINI_MODEL=gemini-flash-latest
# Used automatically if the main model is overloaded (free tier)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# DATABASE_URL=sqlite:///./tactiq.db
CORS_ORIGINS=http://localhost:5173

# One-click demo profile on the login screen (set to false for a real deployment)
DEMO_MODE=true
